# ==============================================================================
# BookNowShisha - cPanel Production Environment Configuration (.env.example)
# Copy this file to .env before starting the application.
# DO NOT COMMIT REAL CREDENTIALS OR PRODUCTION SECRETS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
API_PREFIX=api

# ------------------------------------------------------------------------------
# 2. CPANEL DATABASE (MySQL / MariaDB)
# Format: mysql://<cpanel_user>_<dbuser>:<password>@localhost:3306/<cpanel_user>_<dbname>
# ------------------------------------------------------------------------------
DATABASE_URL="mysql://cpaneluser_bnsuser:YourStrongPasswordHere@localhost:3306/cpaneluser_booknowshisha"

# ------------------------------------------------------------------------------
# 3. REDIS CACHE & LOCKING (OPTIONAL)
# On cPanel shared hosting, local Redis is not installed.
# - If using an external managed Redis (e.g. Upstash, Redis Cloud, Aiven): set REDIS_URL
# - If not using Redis: leave REDIS_URL empty (the app uses database concurrency locks)
# ------------------------------------------------------------------------------
REDIS_URL=""

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & JWT SECURITY
# Generate strong, random 64-character secrets for production
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=replace_with_a_secure_random_jwt_refresh_secret_key
JWT_REFRESH_EXPIRATION=30d

# ------------------------------------------------------------------------------
# 5. PUBLIC URLS & CORS
# ------------------------------------------------------------------------------
API_PUBLIC_URL=https://api.yourdomain.com
CORS_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# ------------------------------------------------------------------------------
# 6. WORDPRESS & WOOCOMMERCE INTEGRATION
# ------------------------------------------------------------------------------
WORDPRESS_URL=https://yourdomain.com
WOOCOMMERCE_CONSUMER_KEY=ck_placeholder_consumer_key_from_woocommerce_settings
WOOCOMMERCE_CONSUMER_SECRET=cs_placeholder_consumer_secret_from_woocommerce_settings
HOOKAH_RENTAL_CORE_SHARED_SECRET=replace_with_strong_shared_secret_matching_wp_settings

# ------------------------------------------------------------------------------
# 7. SMS GATEWAY / OTP PROVIDER (India & International)
# Choose one of: fast2sms | 2factor | msg91 | twilio | generic
# ------------------------------------------------------------------------------
SMS_PROVIDER=fast2sms
SMS_API_KEY=your_sms_provider_api_key

# Fast2SMS (https://www.fast2sms.com)
FAST2SMS_API_KEY=

# 2Factor (https://2factor.in)
TWOFACTOR_API_KEY=

# MSG91 (https://msg91.com)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Twilio (https://www.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------------------------
# 8. SMTP / EMAIL NOTIFICATION SETTINGS (cPanel Webmail or External SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=orders@yourdomain.com
SMTP_PASSWORD=your_email_account_password
SMTP_FROM="BookNowShisha <orders@yourdomain.com>"

# ------------------------------------------------------------------------------
# 9. POSTGRESQL TO MYSQL MIGRATION (Used only when running data migration script)
# ------------------------------------------------------------------------------
# SOURCE_POSTGRES_URL="postgresql://postgres:password@oldhost:5432/booknowshisha_db"
# TARGET_MYSQL_URL="mysql://cpaneluser_bnsuser:password@localhost:3306/cpaneluser_booknowshisha"

# ==============================================================================
# BookNowShisha - Environment Configuration Template (.env.example)
# Copy this file to .env before starting the development environment.
# DO NOT COMMIT REAL CREDENTIALS OR PRODUCTION SECRETS TO VERSION CONTROL.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=booknowshisha_db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booknowshisha_db?schema=public"

# Redis Cache & Fast State Store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# Authentication & JWT Security
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production
JWT_REFRESH_EXPIRATION=30d

# WordPress & WooCommerce Integration (Backend to Headless / Core API)
WORDPRESS_URL=http://localhost:8080
WOOCOMMERCE_CONSUMER_KEY=ck_placeholder_consumer_key_do_not_expose
WOOCOMMERCE_CONSUMER_SECRET=cs_placeholder_consumer_secret_do_not_expose
HOOKAH_RENTAL_CORE_SHARED_SECRET=shared_secret_for_internal_plugin_nest_bridge

# ==============================================================================
# Google OAuth 2.0 Authentication & Admin Allowlist Configuration
# Obtain credentials from: https://console.cloud.google.com/apis/credentials
# See full setup guide in: docs/GOOGLE_OAUTH_SETUP.md
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Comma-separated list of Google accounts authorized to receive ADMIN privileges upon login
ADMIN_GOOGLE_EMAILS=admin@shisharent.com,owner@shisharent.com

# ==============================================================================
# Real SMS Gateway / OTP Provider Configuration (India & International)
# Choose one of: fast2sms | 2factor | msg91 | twilio | generic
# ==============================================================================
SMS_PROVIDER=fast2sms
SMS_API_KEY=your_sms_api_key_here

# Provider-Specific Configurations:
# 1. Fast2SMS (India Quick OTP Route - https://www.fast2sms.com)
FAST2SMS_API_KEY=

# 2. 2Factor (India OTP SMS Gateway - https://2factor.in)
TWOFACTOR_API_KEY=

# 3. MSG91 (DLT SMS Gateway - https://msg91.com)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# 4. Twilio (https://www.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Mail / SMTP Notification Settings
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=placeholder_smtp_username
SMTP_PASSWORD=placeholder_smtp_password
SMTP_FROM="ShishaRent Kolkata <no-reply@shisharent.com>"

# WordPress Local Docker Configuration
WORDPRESS_PORT=8080
WORDPRESS_DB_HOST=wp-mysql
WORDPRESS_DB_USER=wp_user
WORDPRESS_DB_PASSWORD=wp_password
WORDPRESS_DB_NAME=wordpress_db
WORDPRESS_TABLE_PREFIX=bns_

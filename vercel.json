{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/wp-admin/admin-ajax.php",
      "destination": "/api/ajax"
    },
    {
      "source": "/admin-ajax.php",
      "destination": "/api/ajax"
    },
    {
      "source": "/api/delivery/check-zone",
      "destination": "/api/delivery/check-zone"
    },
    {
      "source": "/api/check-zone",
      "destination": "/api/delivery/check-zone"
    },
    {
      "source": "/api/auth/register",
      "destination": "/api/auth/register"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/auth/login"
    },
    {
      "source": "/api/auth/me",
      "destination": "/api/auth/me"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/auth/logout"
    },
    {
      "source": "/api/packages",
      "destination": "/api/packages"
    },
    {
      "source": "/api/flavours",
      "destination": "/api/flavours"
    },
    {
      "source": "/api/bookings",
      "destination": "/api/bookings/create"
    },
    {
      "source": "/api/payments/upi/initiate",
      "destination": "/api/payments/upi/initiate"
    },
    {
      "source": "/api/contact",
      "destination": "/api/contact"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/flavour-selection",
      "destination": "/flavour-selection.html"
    },
    {
      "source": "/shop",
      "destination": "/shop.html"
    },
    {
      "source": "/cart",
      "destination": "/cart.html"
    },
    {
      "source": "/checkout",
      "destination": "/checkout.html"
    },
    {
      "source": "/gallery",
      "destination": "/gallery.html"
    },
    {
      "source": "/bartending-party-services",
      "destination": "/bartending-party-services.html"
    },
    {
      "source": "/party-occasion-hookah",
      "destination": "/party-occasion-hookah.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}